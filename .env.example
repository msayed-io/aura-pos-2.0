# Local persistence (Prisma schema is currently not used by the POS UI)
DATABASE_URL="file:./db/custom.db"

# Required only when enabling WAKZ / WhatsApp integration
WAKZ_BASE_URL="https://your-wakz-host.example"
WAKZ_API_KEY="replace-with-a-server-side-key"
WAKZ_WEBHOOK_SECRET="replace-with-the-webhook-secret"

# Optional AI integration; never expose server secrets with NEXT_PUBLIC_
GEMINI_API_KEY="replace-with-a-gemini-key"
