generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalOrder {
  id           String                @id
  displayId    String                @unique
  requestId    String?               @unique
  createdAt    BigInt
  isArchived   Boolean               @default(false)
  stockApplied Boolean               @default(false)
  source       String                @default("POS")
  draftId      String?               @unique
  printedAt    BigInt?
  data         String
  items        LocalOrderItem[]
  drafts       LocalWhatsAppDraft[]
  printJobs    LocalPrintJob[]
  @@index([createdAt])
}

model LocalOrderItem {
  id      String     @id
  orderId String
  data    String
  order   LocalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model LocalCounter {
  name  String @id
  value Int
}

model LocalInventory {
  id       String @id
  quantity Float
  data     String
}

model LocalSerial {
  serialNumber String @id
  productId    String
  status       String
  addedAt      BigInt
  soldAt       BigInt?
  orderId      String?
  data         String
  @@index([productId, status])
}

model LocalMenu {
  id       String
  kind     String
  position Int    @default(0)
  data     String
  @@id([kind, id])
  @@index([kind, position])
}

model LocalCoupon {
  id         String @id
  code       String @unique
  usageCount Int    @default(0)
  data       String
}

model LocalCouponUsage {
  id        String @id
  couponId  String
  orderId   String
  timestamp BigInt
  data      String
  @@index([couponId, timestamp])
}

model LocalMetadata {
  key   String @id
  value String
}

model LocalNotice {
  id   String @id
  data String
}

model LocalWhatsAppConversation {
  id               String                  @id
  accountId        String
  conversationHash String
  state            String                  @default("active")
  lastMessageAt    BigInt
  updatedAt        BigInt
  messages         LocalWhatsAppMessage[]
  drafts           LocalWhatsAppDraft[]
  @@unique([accountId, conversationHash])
  @@index([lastMessageAt])
}

model LocalWhatsAppMessage {
  id                    String                   @id
  accountId             String
  conversationHash      String
  messageId             String
  text                  String
  status                String                   @default("received")
  attempts              Int                      @default(0)
  receivedAt            BigInt
  updatedAt             BigInt
  replyText             String?
  replyId               String?
  replyStatus           String?
  encryptedReplyTarget  String?
  conversation          LocalWhatsAppConversation @relation(fields: [accountId, conversationHash], references: [accountId, conversationHash], onDelete: Cascade)
  @@unique([accountId, conversationHash, messageId])
  @@index([status, updatedAt])
  @@index([conversationHash, receivedAt])
}

model LocalWhatsAppDraft {
  id               String                    @id
  accountId        String
  conversationHash String
  status           String
  version          Int
  summaryVersion   Int?
  data             String
  createdAt        BigInt
  updatedAt        BigInt
  orderId          String?                   @unique
  conversation     LocalWhatsAppConversation @relation(fields: [accountId, conversationHash], references: [accountId, conversationHash], onDelete: Cascade)
  order            LocalOrder?               @relation(fields: [orderId], references: [id])
}

model LocalPrintJob {
  id          String     @id
  orderId     String
  invoiceType String
  status      String
  attempts    Int        @default(0)
  errorCode   String?
  createdAt   BigInt
  updatedAt   BigInt
  printedAt   BigInt?
  order       LocalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([orderId, invoiceType])
}
