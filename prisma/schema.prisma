generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LocalOrder {
  id          String      @id
  displayId   String      @unique
  requestId   String?     @unique
  createdAt   BigInt
  isArchived  Boolean     @default(false)
  stockApplied Boolean    @default(false)
  data        String
  items       LocalOrderItem[]
  @@index([createdAt])
}

model LocalOrderItem {
  id      String @id
  orderId String
  data    String
  order   LocalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model LocalCounter {
  name  String @id
  value Int
}

model LocalInventory {
  id      String @id
  quantity Float
  data    String
}

model LocalSerial {
  serialNumber String @id
  productId    String
  status       String
  addedAt      BigInt
  soldAt       BigInt?
  orderId      String?
  data         String
  @@index([productId, status])
}

model LocalMenu {
  id       String
  kind     String
  position Int    @default(0)
  data     String
  @@id([kind, id])
  @@index([kind, position])
}

model LocalCoupon {
  id         String @id
  code       String @unique
  usageCount Int    @default(0)
  data       String
}

model LocalCouponUsage {
  id       String @id
  couponId String
  orderId  String
  timestamp BigInt
  data     String
  @@index([couponId, timestamp])
}

model LocalMetadata {
  key   String @id
  value String
}

model LocalNotice {
  id   String @id
  data String
}
